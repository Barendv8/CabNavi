# --- Personal data ---------------------------------------------------------
# Everything the plugin writes lives in %APPDATA%\CabNavi and must never end
# up here. instellingen.json holds your Discord webhook, which is a secret:
# anyone who has it can post in your channel. trips.jsonl is your own driving
# history.
*.log
debug.log
trips.jsonl
instellingen.json
uiterlijk.json
tachograaf.json
vtc.json
spelers_vtc.json
brandstofprijzen.json
incident_instellingen.json
imgui.ini
# v1.1: per-game files and the VTC webhook key
trips_ats.jsonl
meting.txt
meting_ats.txt
voertuigen.txt
discord.json
vtc_webhook.json
vtc_bron.json
brandstof_trucks.json
# game saves (only ever read, never belong here)
*.sii

# --- OS --------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
# receivers/discord-bot: the owner's own token and database
receivers/discord-bot/config.json
receivers/discord-bot/*.sqlite
